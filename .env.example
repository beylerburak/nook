POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql://nook:replace-with-a-long-random-password@localhost:15481/nook
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:18481
NOOK_ALLOWED_ORIGINS=chrome-extension://gldaimigcbcmgadpknjhpnhopfiedgno
# Only turn this on while creating the first account, then set it back to false.
NOOK_ALLOW_SIGNUP=false
# AI (optional). Without TYPESAFE_API_KEY the AI settings panel reports the
# feature as unavailable; the other three only drive taxonomy proposals.
TYPESAFE_API_KEY=
# Which generative provider proposes new collections and tags: openai or gemini.
NOOK_AI_PROPOSER=
# Which model names the new collections and tags. gpt-4o-mini is the default
# because it measured cleaner on a Turkish library; gpt-5-nano also works.
NOOK_AI_MODEL=
OPENAI_API_KEY=
GEMINI_API_KEY=
# Search index (optional, and independent of the two above). With no
# OPENAI_API_KEY the search route reports the index as unavailable and the client
# keeps its own substring pass; these two only choose what the index is built
# with. Leave them blank for the measured defaults.
# text-embedding-3-small is the strongest of the three measured on Turkish
# retrieval (TR-MTEB) and the cheapest at 768 dimensions.
NOOK_EMBEDDING_MODEL=
# Truncation is not re-billed, so this is a storage dial rather than a
# commitment: 1,055 texts cost the same at 256, 768 and 1536.
NOOK_EMBEDDING_DIM=
NOOK_WEB_HOST_PORT=18481
NOOK_API_HOST_PORT=18482
NOOK_DB_HOST_PORT=15481
