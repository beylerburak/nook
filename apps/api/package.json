{
  "name": "@nook/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "migrate": "tsx src/migrate.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.0",
    "better-auth": "^1.7.6",
    "hono": "^4.9.0",
    "pg": "^8.16.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/pg": "^8.15.5",
    "tsx": "^4.20.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
