{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["chrome", "vitest/globals", "node", "vite/client"]
  },
  "include": ["**/*.ts", "**/*.tsx", "**/*.d.ts", ".wxt/wxt.d.ts"],
  "exclude": [".output", ".wxt", "node_modules"]
}
